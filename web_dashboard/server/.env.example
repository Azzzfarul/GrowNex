PORT=5000
# Web origins allowed to call the API (comma-separated), e.g. add http://localhost:4173 for vite preview
CLIENT_ORIGIN=http://localhost:3000
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
MQTT_BROKER_HOST=your_cluster.s1.eu.hivemq.cloud
MQTT_BROKER_PORT=8883
MQTT_USER=your_mqtt_username
MQTT_PASS=your_mqtt_password

# AI (OpenRouter — OpenAI-compatible). Leave OPENROUTER_API_KEY blank to disable
# the AI features; the analytics summary / advice / automation plan then fall back
# to the deterministic rule-based output.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Image diagnosis (plant photos, camera check). Must be a model that accepts images;
# defaults to OPENROUTER_MODEL. For evaluation runs use a dated model ID.
OPENROUTER_VISION_MODEL=
# Camera check: alert only when the model's confidence is at least this (set from eval/README.md calibration)
VISION_NOTIFY_MIN_CONFIDENCE=0.6
AI_CACHE_TTL_MS=1800000

# Pl@ntNet plant identification ("Identify" in the add-plant form). Free key, 500 IDs/day:
# https://my.plantnet.org → My API key. Blank = the Identify button says it's unavailable.
PLANTNET_API_KEY=

# Nightly per-user summary notification (node-cron expression + IANA timezone)
DAILY_SUMMARY_CRON=0 20 * * *
DAILY_SUMMARY_TZ=Asia/Kuala_Lumpur

# Server local time. The automation schedules (watering "07:00", lights "08:00–18:00", ...) run in
# it, and so does "today" in the nightly summary. Set it to the growers' timezone: the Docker image
# (and most cloud hosts) default to UTC, which would water at 15:00 and light at night in Malaysia.
TZ=Asia/Kuala_Lumpur
