PORT=5000
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
MQTT_BROKER_HOST=your_cluster.s1.eu.hivemq.cloud
MQTT_BROKER_PORT=8883
MQTT_USER=your_mqtt_username
MQTT_PASS=your_mqtt_password

# AI (OpenRouter — OpenAI-compatible). Leave OPENROUTER_API_KEY blank to disable
# the AI features; the analytics summary / advice / automation plan then fall back
# to the deterministic rule-based output.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_CACHE_TTL_MS=1800000
