// Cloud Storage security rules for project grownex-iot. Deploy from web_dashboard/:
//   npx firebase-tools deploy --only storage --project grownex-iot
// Each photo belongs to its zone's owner and members, looked up in Firestore. Download URLs that
// carry a token (what the apps store and show) keep working regardless of these rules.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function fsDoc(path) { return firestore.get(/databases/(default)/documents/$(path)); }
    // Owner, or a member (zones.memberIds; zones from before sharing have none). Same as firestore.rules.
    function ownsZone(zoneId) {
      let zone = fsDoc(/zones/$(zoneId)).data;
      return signedIn() && (zone.userId == request.auth.uid || request.auth.uid in zone.get('memberIds', []));
    }
    function idOf(fileName) { return fileName.split('[.]')[0]; }  // "<docId>.jpg" → docId

    match /zonePhotos/{fileName} {
      allow read, write: if ownsZone(idOf(fileName));
    }

    // One photo per 4-hour bucket; the server also writes here (and bypasses these rules).
    match /zoneSnapshots/{zoneId}/{fileName} {
      allow read, write: if ownsZone(zoneId);
    }

    // Close-ups for a plant diagnosis, under their author's uid; the server reads them (and
    // bypasses these rules). Members of the diagnosis's zone may delete one too (history and the
    // plant delete cascade): both apps delete the photo before its plantDiagnoses doc.
    match /plantDiagnoses/{userId}/{fileName} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      allow delete: if ownsZone(fsDoc(/plantDiagnoses/$(idOf(fileName))).data.zoneId);
    }

    // The plant doc must exist: both apps create it before uploading, and delete the photo first.
    match /plantPhotos/{fileName} {
      allow read, write: if signedIn() && ownsZone(fsDoc(/plants/$(idOf(fileName))).data.zoneId);
    }
  }
}
